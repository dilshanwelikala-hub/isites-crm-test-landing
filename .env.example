PAYLOAD_SECRET=replace-with-a-long-random-secret
# Dedicated signing key with at least 32 characters, different from PAYLOAD_SECRET.
# Missing/short/reused keys disable draft preview. Raw keys are never sent in URLs.
PREVIEW_SECRET=replace-with-a-separate-long-random-signing-key
DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require
# Local fallback only, used when DATABASE_URL / POSTGRES_URL is not set.
DATABASE_URI=file:./payload-data.db
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PAYLOAD_PUBLIC_SITE_URL=https://your-production-domain.com
